<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyFantasyMAUI"
             x:Class="DailyFantasyMAUI.BackTestPage"
             Title="Back-Test"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,1">

        <!-- Row 0: Nav header -->
        <Grid Grid.Row="0" BackgroundColor="#1E2733" Padding="14,10"
              ColumnDefinitions="Auto,*,Auto">
            <GraphicsView Grid.ColumnSpan="3"
                          Opacity="0.70" HeightRequest="54" WidthRequest="54"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          InputTransparent="True">
                <GraphicsView.Drawable><local:BallWatermark/></GraphicsView.Drawable>
            </GraphicsView>
            <Button Grid.Column="0" Text="⌂" FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#2D3D50" TextColor="White" Padding="10,0"
                    HeightRequest="34" CornerRadius="17"
                    Clicked="BtnGoHome_Clicked" Margin="0,0,6,0"/>
            <Label Grid.Column="1" Text="Back-Test Numbers" TextColor="White" FontSize="14"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Picker Grid.Column="2" x:Name="gamePicker" FontSize="11"
                    TextColor="White" BackgroundColor="#2D3D50"
                    WidthRequest="110" HeightRequest="34"
                    SelectedIndexChanged="GamePicker_Changed"/>
        </Grid>

        <!-- Row 1: Game logo banner -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="8,6">
            <Image x:Name="imgGameLogo" HeightRequest="80"
                   Aspect="AspectFit" HorizontalOptions="Center"/>
        </Border>

        <!-- Row 2: Numbers section header (tap to collapse/expand) -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="14,8"
              ColumnDefinitions="Auto,*,Auto,Auto">
            <Label Grid.Column="0" x:Name="lblChevron" Text="▼"
                   FontSize="13" TextColor="#1565C0" VerticalOptions="Center" Margin="0,0,8,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NumbersHeader_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" x:Name="lblNumsHeader" Text="Your Numbers to Back-Test  (tap to collapse)"
                   FontSize="13" FontAttributes="Bold" TextColor="#374151" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NumbersHeader_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Button Grid.Column="2" Text="＋" FontSize="16" FontAttributes="Bold"
                    BackgroundColor="#1565C0" TextColor="White"
                    HeightRequest="32" WidthRequest="32" CornerRadius="16" Padding="0"
                    Clicked="BtnAddRow_Clicked" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Text="Clear" FontSize="11"
                    BackgroundColor="#FF7043" TextColor="White"
                    HeightRequest="32" CornerRadius="8" Padding="6,0"
                    Clicked="BtnClearRows_Clicked"/>
        </Grid>

        <!-- Row 3: Number rows (collapsible body) -->
        <ScrollView Grid.Row="3" x:Name="numbersScrollView" BackgroundColor="White"
                    MaximumHeightRequest="280">
            <VerticalStackLayout x:Name="numbersContainer" Padding="10,4,10,8" Spacing="5"/>
        </ScrollView>

        <!-- Row 4: Date range filter -->
        <VerticalStackLayout Grid.Row="4" BackgroundColor="White" Spacing="0">
            <Label Text="Draw date range — leave blank to test all history"
                   FontSize="10" TextColor="#9CA3AF" Padding="14,4,14,0"/>
            <Grid Padding="10,4,10,8"
                  ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                <Label Grid.Column="0" Text="From:" FontSize="12" FontAttributes="Bold"
                       TextColor="#374151" VerticalOptions="Center" Margin="0,0,4,0"/>
                <Picker Grid.Column="1" x:Name="pickerFromMonth"
                        FontSize="12" TextColor="#1A1A1A" BackgroundColor="#E3F2FD"
                        HeightRequest="38" HorizontalOptions="Fill"/>
                <Label Grid.Column="2" Text="/" FontSize="13" FontAttributes="Bold"
                       TextColor="#374151" VerticalOptions="Center" Margin="2,0"/>
                <Picker Grid.Column="3" x:Name="pickerFromYear"
                        FontSize="12" TextColor="#1A1A1A" BackgroundColor="#E3F2FD"
                        HeightRequest="38" HorizontalOptions="Fill"/>
                <Label Grid.Column="4" Text="To:" FontSize="12" FontAttributes="Bold"
                       TextColor="#374151" VerticalOptions="Center" Margin="8,0,4,0"/>
                <Picker Grid.Column="5" x:Name="pickerToMonth"
                        FontSize="12" TextColor="#1A1A1A" BackgroundColor="#E3F2FD"
                        HeightRequest="38" HorizontalOptions="Fill"/>
                <Label Grid.Column="6" Text="/" FontSize="13" FontAttributes="Bold"
                       TextColor="#374151" VerticalOptions="Center" Margin="2,0"/>
                <Picker Grid.Column="7" x:Name="pickerToYear"
                        FontSize="12" TextColor="#1A1A1A" BackgroundColor="#E3F2FD"
                        HeightRequest="38" HorizontalOptions="Fill"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Row 5: Results area -->
        <Grid Grid.Row="5" BackgroundColor="#F0F4F8">
            <Grid RowDefinitions="Auto,Auto,Auto,*">

                <!-- Run button row -->
                <Grid Grid.Row="0" BackgroundColor="White" Padding="14,10,14,10"
                      ColumnDefinitions="Auto,*">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Button x:Name="btnRun" Text="Run Back-Test"
                                FontSize="14" FontAttributes="Bold"
                                BackgroundColor="#2E7D32" TextColor="White"
                                HeightRequest="44" CornerRadius="22" Padding="16,0"
                                Clicked="BtnRun_Clicked"/>
                        <Label Text="See how often your numbers matched past draws"
                               FontSize="9" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" x:Name="lblSummary" Text=""
                           FontSize="11" TextColor="#374151"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           Margin="8,0,0,0"/>
                </Grid>

                <!-- Stats card (hidden until run) -->
                <Border Grid.Row="1" x:Name="statsCard" IsVisible="False"
                        Margin="10,8,10,0" BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">
                        <!-- Card header -->
                        <Grid BackgroundColor="#1E2733" Padding="14,10"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" x:Name="lblStatsTitle"
                                   Text="Back-Test Results" TextColor="White"
                                   FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="lblStatsDraws"
                                   Text="" TextColor="#8B9DC3"
                                   FontSize="11" VerticalOptions="Center"/>
                        </Grid>
                        <!-- Tier grid inserted in code -->
                        <VerticalStackLayout x:Name="statsTiersHost" Padding="0"/>
                        <!-- Best match footer -->
                        <Label x:Name="lblStatsBest" Text=""
                               FontSize="12" TextColor="#374151"
                               Padding="14,8" BackgroundColor="#F8F9FA"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Filter bar (hidden until results ready) -->
                <ScrollView Grid.Row="2" x:Name="filterBarScroll" IsVisible="False"
                            Orientation="Horizontal" BackgroundColor="White"
                            HeightRequest="44" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="filterBar" Spacing="5" Padding="8,5"/>
                </ScrollView>

                <!-- Matching draws scroll -->
                <ScrollView Grid.Row="3" BackgroundColor="#F0F4F8">
                    <VerticalStackLayout x:Name="resultsContainer" Padding="10,8" Spacing="8"/>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Row 6: Status bar -->
        <Label Grid.Row="6" x:Name="lblStatus"
               Text="Select a game, enter your picks, then tap Run Back-Test."
               BackgroundColor="#1E2733" TextColor="#8B9DC3"
               FontSize="12" Padding="14,6" LineBreakMode="TailTruncation"/>

        <!-- Loading overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="8" x:Name="loadingOverlay"
              BackgroundColor="#CC1E2733" IsVisible="False" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="White"
                                   WidthRequest="56" HeightRequest="56"/>
                <Label x:Name="lblLoadingMsg" Text="Analyzing..."
                       TextColor="White" FontSize="16" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label x:Name="lblLoadingPct" Text=""
                       TextColor="#8B9DC3" FontSize="13"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
