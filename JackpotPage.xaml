<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyFantasyMAUI"
             x:Class="DailyFantasyMAUI.JackpotPage"
             Title="Jackpot Winners"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPagePan"/>
        </Grid.GestureRecognizers>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1E2733" Padding="10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <GraphicsView Grid.ColumnSpan="4"
                          Opacity="0.70" HeightRequest="54" WidthRequest="54"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          InputTransparent="True">
                <GraphicsView.Drawable><local:BallWatermark/></GraphicsView.Drawable>
            </GraphicsView>
            <Button Grid.Column="0" Text="◀" FontSize="16" BackgroundColor="Transparent"
                    TextColor="White" Padding="4,0" HeightRequest="34" WidthRequest="40"
                    Clicked="BtnBack_Clicked"/>
            <Label Grid.Column="1" Text="Jackpot Winners" TextColor="White"
                   FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                   HorizontalOptions="Center"/>
            <Button Grid.Column="2" Text="↕" FontSize="16" BackgroundColor="Transparent"
                    TextColor="#8B9DC3" Padding="4,0" HeightRequest="34" WidthRequest="36"
                    Clicked="BtnSort_Clicked"/>
            <Button Grid.Column="3" Text="Refresh" FontSize="12" BackgroundColor="#2D3D50"
                    TextColor="White" Padding="12,0" HeightRequest="34" CornerRadius="17"
                    Clicked="BtnRefresh_Clicked"/>
        </Grid>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="1" x:Name="progressBar" Progress="0"
                     ProgressColor="#FF8F00" BackgroundColor="#2D3D50"
                     HeightRequest="3" IsVisible="False"/>

        <!-- Cards -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="cardsStack" Spacing="8" Padding="10,8,10,8">

                <Label x:Name="lblLastChecked" Text="" HorizontalOptions="Center"
                       FontSize="11" TextColor="#9CA3AF"/>

                <!-- Fantasy 5 -->
                <Frame x:Name="cardF5" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="F5"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#FF8F00"/>
                        <Image Source="logo_fantasy5.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <VerticalStackLayout Padding="14,0,14,0" Spacing="2">
                            <Label x:Name="lblF5Jackpot" Text="" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1E2733"/>
                            <Label x:Name="lblF5Result" Text="" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,8,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblF5Date" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblF5Badge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsF5" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Super Lotto Plus -->
                <Frame x:Name="cardSL" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="SL"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#7B1FA2"/>
                        <Image Source="logo_superlotto.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <VerticalStackLayout Padding="14,0,14,0" Spacing="2">
                            <Label x:Name="lblSLJackpot" Text="" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1E2733"/>
                            <Label x:Name="lblSLResult" Text="" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,8,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblSLDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblSLBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsSL" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Powerball -->
                <Frame x:Name="cardPB" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="PB"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#C62828"/>
                        <Image Source="logo_powerball.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <VerticalStackLayout Padding="14,0,14,0" Spacing="2">
                            <Label x:Name="lblPBJackpot" Text="" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1E2733"/>
                            <Label x:Name="lblPBResult" Text="" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,8,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblPBDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblPBBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsPB" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Mega Millions -->
                <Frame x:Name="cardMM" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="MM"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#F9A825"/>
                        <Image Source="logo_megamillions.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <VerticalStackLayout Padding="14,0,14,0" Spacing="2">
                            <Label x:Name="lblMMJackpot" Text="" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1E2733"/>
                            <Label x:Name="lblMMResult" Text="" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,8,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblMMDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblMMBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsMM" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily Derby -->
                <Frame x:Name="cardDD" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="DD"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#5D4037"/>
                        <Image Source="logo_dailyderby.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <VerticalStackLayout Padding="14,0,14,0" Spacing="2">
                            <Label x:Name="lblDDJackpot" Text="" FontSize="26"
                                   FontAttributes="Bold" TextColor="#1E2733"/>
                            <Label x:Name="lblDDResult" Text="" FontSize="13" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,8,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblDDDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblDDBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsDD" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily 4 -->
                <Frame x:Name="cardD4" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="D4"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#00695C"/>
                        <Image Source="logo_daily4.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,6,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblD4Date" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblD4Badge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsD4" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label x:Name="lblD4Result" Text="" FontSize="13" TextColor="#6B7280"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily 3 Evening -->
                <Frame x:Name="cardD3Eve" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="D3E"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#1976D2"/>
                        <Image Source="logo_daily3.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,6,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblD3EveDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblD3EveBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsD3Eve" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label x:Name="lblD3EveResult" Text="" FontSize="13" TextColor="#6B7280"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily 3 Midday -->
                <Frame x:Name="cardD3Mid" BackgroundColor="White" CornerRadius="16"
                       BorderColor="#E5E7EB" Padding="0" HasShadow="False"
                       IsClippedToBounds="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="D3M"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="10" Color="#1976D2"/>
                        <Image Source="logo_daily3.png" HeightRequest="80"
                               HorizontalOptions="Center" Aspect="AspectFit" Margin="16,8,16,4"/>
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="14,6,14,8"/>
                        <VerticalStackLayout Padding="14,0,14,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" x:Name="lblD3MidDate" Text=""
                                       FontSize="13" TextColor="#6B7280"/>
                                <Label Grid.Column="1" x:Name="lblD3MidBadge" Text=""
                                       FontSize="11" FontAttributes="Bold" TextColor="White"
                                       BackgroundColor="#9CA3AF" Padding="10,3" VerticalOptions="Center"/>
                            </Grid>
                            <FlexLayout x:Name="ballsD3Mid" Wrap="Wrap" Direction="Row"
                                        AlignItems="Center" Margin="0,4,0,0"/>
                            <Label x:Name="lblD3MidResult" Text="" FontSize="13" TextColor="#6B7280"/>
                            <Label Text="Tap for payout details ▶" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Status bar (tap to copy log) -->
        <Label Grid.Row="3" x:Name="lblStatus" Text="Loading..."
               BackgroundColor="#1E2733" TextColor="#8B9DC3"
               FontSize="12" Padding="14,5" LineBreakMode="TailTruncation">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="LblStatus_Tapped"/>
            </Label.GestureRecognizers>
        </Label>

        <!-- ═══════════════════════════════════════════════════════════
             Full-page Draw Results overlay (shown when card is tapped)
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="overlayGrid" Grid.Row="0" Grid.RowSpan="4"
              BackgroundColor="White" IsVisible="False">
            <Grid RowDefinitions="Auto,*">

                <!-- Colored header -->
                <Grid Grid.Row="0" x:Name="overlayHeader" BackgroundColor="#FF8F00" Padding="6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Text="←" FontSize="20" BackgroundColor="Transparent"
                            TextColor="White" WidthRequest="48" HeightRequest="44"
                            Clicked="BtnCloseOverlay_Clicked"/>
                    <Label Grid.Column="1" Text="Draw Results" TextColor="White"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <!-- Scrollable detail content -->
                <ScrollView Grid.Row="1" BackgroundColor="#F0F4F8">
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                        <!-- White detail card -->
                        <Frame Margin="12,14,12,0" BackgroundColor="White"
                               CornerRadius="12" BorderColor="#E5E7EB"
                               Padding="16,16" HasShadow="False">
                            <VerticalStackLayout Spacing="0">

                                <!-- Game logo -->
                                <Image x:Name="overlayGameLogo"
                                       HeightRequest="80" HorizontalOptions="Center"
                                       Aspect="AspectFit" Margin="0,0,0,6"/>

                                <!-- Game name -->
                                <Label x:Name="overlayGameName" Text=""
                                       FontSize="18" FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,16"/>

                                <!-- DRAW section -->
                                <Label Text="DRAW" FontSize="12" FontAttributes="Bold"
                                       TextColor="#00A0DC" Margin="0,0,0,4"/>
                                <BoxView HeightRequest="1.5" Color="#00A0DC" Margin="0,0,0,10"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDrawDateTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" x:Name="overlayDrawDate"
                                           Text="" FontSize="18" FontAttributes="Bold"
                                           TextColor="#1E2733" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" x:Name="overlayDropArrow" Text="▼" TextColor="#9CA3AF"
                                           FontSize="14" VerticalOptions="Center"/>
                                </Grid>

                                <!-- Draw history picker dropdown -->
                                <Frame x:Name="drawPickerFrame" IsVisible="False"
                                       BackgroundColor="White" CornerRadius="8"
                                       BorderColor="#D1D5DB" Padding="0" HasShadow="False"
                                       Margin="0,0,0,12">
                                    <VerticalStackLayout x:Name="drawPickerStack" Spacing="0"/>
                                </Frame>

                                <!-- WINNING NUMBERS section -->
                                <Label Text="WINNING NUMBERS" FontSize="12" FontAttributes="Bold"
                                       TextColor="#00A0DC" Margin="0,0,0,4"/>
                                <BoxView HeightRequest="1.5" Color="#00A0DC" Margin="0,0,0,12"/>

                                <!-- Number balls (added dynamically) -->
                                <FlexLayout x:Name="overlayNumbersPanel"
                                            Wrap="Wrap" JustifyContent="Center"
                                            AlignItems="Center" Direction="Row"
                                            Margin="0,0,0,8"/>

                                <!-- Race time for Daily Derby -->
                                <Label x:Name="overlayRaceTime" Text="" IsVisible="False"
                                       FontSize="13" TextColor="#6B7280"
                                       HorizontalOptions="Center" Margin="0,0,0,12"/>

                                <!-- PRIZES section -->
                                <Label Text="PRIZES" FontSize="12" FontAttributes="Bold"
                                       TextColor="#00A0DC" Margin="0,8,0,4"/>
                                <BoxView HeightRequest="1.5" Color="#00A0DC" Margin="0,0,0,0"/>

                                <!-- Prize rows (added dynamically) -->
                                <VerticalStackLayout x:Name="overlayPrizesPanel" Spacing="0"/>

                            </VerticalStackLayout>
                        </Frame>

                        <!-- Close button at bottom -->
                        <Button Text="Close" Margin="24,20,24,0"
                                BackgroundColor="#1E2733" TextColor="White"
                                FontSize="15" HeightRequest="48" CornerRadius="24"
                                Clicked="BtnCloseOverlay_Clicked"/>

                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             Reorder overlay
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="reorderOverlay" Grid.Row="0" Grid.RowSpan="4"
              BackgroundColor="White" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" BackgroundColor="#1E2733" Padding="10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Text="←" FontSize="20" BackgroundColor="Transparent"
                            TextColor="White" WidthRequest="48" HeightRequest="44"
                            Clicked="BtnReorderCancel_Clicked"/>
                    <Label Grid.Column="1" Text="Arrange Games" TextColor="White"
                           FontSize="15" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <ScrollView Grid.Row="1" BackgroundColor="#F0F4F8">
                    <VerticalStackLayout x:Name="reorderStack" Spacing="8" Padding="12,16"/>
                </ScrollView>

                <Button Grid.Row="2" Text="Save Order" BackgroundColor="#1E2733"
                        TextColor="White" FontSize="15" HeightRequest="50"
                        CornerRadius="25" Margin="24,12,24,16"
                        Clicked="BtnReorderDone_Clicked"/>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
