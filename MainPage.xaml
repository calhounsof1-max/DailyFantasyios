<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:DailyFantasyMAUI.Converters"
             xmlns:model="clr-namespace:DailyFantasyMAUI.Model"
             xmlns:local="clr-namespace:DailyFantasyMAUI"
             x:Class="DailyFantasyMAUI.MainPage"
             Title="Lottery"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D1B2A">

    <ContentPage.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>

        <!-- Ball box border — round lottery-ball style -->
        <Style x:Key="BallFrame" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A3F8A"/>
            <Setter Property="Stroke" Value="#60A5FA"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            <Setter Property="HeightRequest" Value="26"/>
        </Style>

        <!-- Shared action button style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="HeightRequest" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- Stat card (COMBOS / COUNT) -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#0E2039"/>
            <Setter Property="Stroke" Value="#1E3A5F"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPagePan"/>
        </Grid.GestureRecognizers>

        <!-- ══════════════════════════════════════════════
             Row 0 — Header
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" BackgroundColor="#0A1628" Padding="14,7,14,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + title in column 0 -->
            <Grid Grid.Column="0" ColumnDefinitions="44,*" ColumnSpacing="6" VerticalOptions="Center">
                <GraphicsView Grid.Column="0"
                              Opacity="0.90" HeightRequest="40" WidthRequest="40"
                              VerticalOptions="Center">
                    <GraphicsView.Drawable><local:BallWatermark/></GraphicsView.Drawable>
                </GraphicsView>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="CA 7 Tracker" TextColor="#60A5FA"
                           FontSize="14" FontAttributes="Bold" CharacterSpacing="0.5"
                           LineBreakMode="NoWrap" TextDecorations="None">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CalLottery_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="California Lottery" TextColor="#4A7FB5"
                           FontSize="9" CharacterSpacing="1"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
            </Grid>

            <Button Grid.Column="1" x:Name="btnNavDropdown"
                    Text="Games ▾" FontSize="12" FontAttributes="Bold"
                    BackgroundColor="#132540" TextColor="#5B9BD5"
                    Padding="14,0" HeightRequest="36" CornerRadius="8"
                    Margin="0,0,8,0"
                    Clicked="BtnNavDropdown_Clicked"/>

            <!-- Mode selector — single dropdown button -->
            <Button Grid.Column="2" x:Name="btnModeSelect"
                    Text="F5 ▾" FontSize="11" FontAttributes="Bold"
                    BackgroundColor="#FF8F00" TextColor="White"
                    Padding="10,0" HeightRequest="30" CornerRadius="8"
                    Clicked="BtnModeSelect_Clicked"/>
        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 1 — Last Draw card
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" BackgroundColor="#0E2039"
              ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="0">
            <BoxView Grid.Column="0" BackgroundColor="#F59E0B"/>
            <Label Grid.Column="2" x:Name="txtLastDraw"
                   Text="{Binding LastNumberHit}"
                   Padding="0,5" Margin="12,0,0,0" FontSize="13" TextColor="#94B8D8"
                   LineBreakMode="WordWrap"/>
            <Label Grid.Column="3" x:Name="txtTicketCount"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#F59E0B" VerticalOptions="Center"
                   Margin="0,0,10,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TxtTicketCount_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 2 — Number boxes 1–5
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="10,2,10,1" ColumnSpacing="4"
              ColumnDefinitions="*,*,*,*,*">
            <Border Grid.Column="0" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box1" Text="1" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box2" Text="2" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box3" Text="3" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box4" Text="4" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box5" Text="5" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
        </Grid>

        <!-- Row 3 — Number boxes 6–10 -->
        <Grid Grid.Row="3" Margin="10,1,10,1" ColumnSpacing="4"
              ColumnDefinitions="*,*,*,*,*">
            <Border Grid.Column="0" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box6" Text="6" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box7" Text="7" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box8" Text="8" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box9" Text="9" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource BallFrame}">
                <Entry x:Name="Box10" Text="10" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="Transparent"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
            </Border>
        </Grid>

        <!-- Row 4 — Box11–15 always visible; Mega Ball row shown below for SL/PB/MM -->
        <VerticalStackLayout Grid.Row="4" Spacing="2" Padding="0,0,0,6">
            <Grid x:Name="boxRow3" Margin="10,2,10,0" ColumnSpacing="4"
                  ColumnDefinitions="*,*,*,*,*">
                <Border Grid.Column="0" Style="{StaticResource BallFrame}">
                    <Entry x:Name="Box11" Text="11" Keyboard="Numeric"
                           TextColor="White" BackgroundColor="Transparent"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource BallFrame}">
                    <Entry x:Name="Box12" Text="12" Keyboard="Numeric"
                           TextColor="White" BackgroundColor="Transparent"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource BallFrame}">
                    <Entry x:Name="Box13" Text="13" Keyboard="Numeric"
                           TextColor="White" BackgroundColor="Transparent"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource BallFrame}">
                    <Entry x:Name="Box14" Text="14" Keyboard="Numeric"
                           TextColor="White" BackgroundColor="Transparent"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource BallFrame}">
                    <Entry x:Name="Box15" Text="15" Keyboard="Numeric"
                           TextColor="White" BackgroundColor="Transparent"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" MaxLength="2" HeightRequest="20"/>
                </Border>
            </Grid>

            <!-- Mega Ball row — shown for SL / PB / MM -->
            <Border x:Name="megaRow" IsVisible="False"
                    Margin="10,2,0,0" HeightRequest="32"
                    HorizontalOptions="Start"
                    BackgroundColor="#1A3F8A" Stroke="#F59E0B"
                    StrokeThickness="2" StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MegaBall_Tapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" Padding="10,0">
                    <Label Text="⭐ MEGA"
                           FontSize="9" FontAttributes="Bold"
                           TextColor="#F59E0B" VerticalOptions="Center"/>
                    <Label x:Name="MegaLabel" Text="—"
                           TextColor="#F59E0B" FontSize="14" FontAttributes="Bold"
                           MinimumWidthRequest="30"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label x:Name="lblMegaRange"
                           Text="1–27" FontSize="9" TextColor="#F59E0B"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- ══════════════════════════════════════════════
             Row 5 — PICK / FROM / COMBOS / COUNT
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="5" Margin="10,4,10,0" ColumnSpacing="6"
              ColumnDefinitions="*,*,Auto,Auto">

            <!-- PICK -->
            <Border Grid.Column="0" BackgroundColor="#0E2039" Stroke="#1E3A5F"
                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                    Padding="0,2,0,0" VerticalOptions="Start">
                <Grid RowDefinitions="Auto,*" Padding="0">
                    <Label Grid.Row="0" Text="PICK" FontSize="9" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="1"
                           HorizontalOptions="Center"/>
                    <Entry Grid.Row="1" x:Name="MaxNum" Text="5" Keyboard="Numeric"
                           FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="White" BackgroundColor="#0E2039"
                           HeightRequest="28" TextChanged="MaxNum_TextChanged"/>
                </Grid>
            </Border>

            <!-- FROM -->
            <Border Grid.Column="1" BackgroundColor="#0E2039" Stroke="#1E3A5F"
                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                    Padding="0,2,0,0" VerticalOptions="Start">
                <Grid RowDefinitions="Auto,*" Padding="0">
                    <Label Grid.Row="0" Text="FROM" FontSize="9" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="1"
                           HorizontalOptions="Center"/>
                    <Entry Grid.Row="1" x:Name="HowMany" Text="39" Keyboard="Numeric"
                           FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="White" BackgroundColor="#0E2039"
                           HeightRequest="28" TextChanged="HowMany_TextChanged"/>
                </Grid>
            </Border>

            <!-- COMBOS -->
            <Border Grid.Column="2" BackgroundColor="#0E2039" Stroke="#1E3A5F"
                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                    Padding="6,4" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="COMBOS" FontSize="7" FontAttributes="Bold"
                           TextColor="#4A7FB5" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                    <Label x:Name="posComb"
                           Text="{Binding PossibleCombinations, StringFormat='{0:N0}'}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#F59E0B" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- COUNT -->
            <Border Grid.Column="3" BackgroundColor="#0E2039" Stroke="#1E3A5F"
                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                    Padding="6,4" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="COUNT" FontSize="7" FontAttributes="Bold"
                           TextColor="#4A7FB5" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                    <Label x:Name="lblCount"
                           Text="{Binding NumberInList}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#EF4444" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 6 — Action buttons
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="6" Margin="10,8,10,8" ColumnSpacing="5"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto">

            <Button Grid.Column="0" Text="🎲 Quick"
                    Style="{StaticResource ActionBtn}"
                    BackgroundColor="#6D28D9"
                    Clicked="BtnQuickPick_Clicked"/>

            <Button Grid.Column="1" Text=">>"
                    Style="{StaticResource ActionBtn}"
                    BackgroundColor="#475569"
                    Clicked="BtnShiftRight_Clicked" IsVisible="False"/>

            <Button Grid.Column="2" Text="✕ Clear"
                    Style="{StaticResource ActionBtn}"
                    BackgroundColor="#B91C1C"
                    Clicked="BtnClear_Clicked"/>

            <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                <CheckBox x:Name="chkBoxPerms" Grid.Column="0"
                          Color="#3B82F6" VerticalOptions="Center" Margin="2,0,0,0"/>
                <Label Grid.Column="1" Text="Perms"
                       FontSize="9" FontAttributes="Bold" TextColor="#3B82F6"
                       VerticalOptions="Center" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Text="⚡ Combos"
                        Style="{StaticResource ActionBtn}"
                        BackgroundColor="#2563EB"
                        Clicked="BtnProcess_Clicked"/>
            </Grid>

            <Button Grid.Column="4" Text="🔍 Draws"
                    Style="{StaticResource ActionBtn}"
                    BackgroundColor="#0F766E"
                    Clicked="BtnDraws_Clicked"/>

        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 7 — Lists + Jackpot Panel
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="7" BackgroundColor="#0D1B2A" RowDefinitions="Auto,*">
            <local:JackpotDisplay x:Name="jackpotPanel" Grid.Row="0"/>
            <Grid x:Name="listsContainer" Grid.Row="1">

            <!-- History list -->
            <CollectionView x:Name="lstHistory"
                            IsVisible="{Binding ShowHistory}"
                            ItemsSource="{Binding Picks}"
                            SelectionMode="Single"
                            SelectionChanged="History_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,5" BackgroundColor="#0D1B2A">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D1B2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D1B2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border BackgroundColor="#0E2039" Stroke="#1E3A5F"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                                    <BoxView Grid.Column="0" BackgroundColor="#3B82F6"
                                             WidthRequest="4" CornerRadius="4,0,4,0"/>
                                    <local:BubbleNumberRow Grid.Column="1"
                                           Text="{Binding .}"
                                           ShowBubbles="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.ShowBubbles}"
                                           HasMegaBall="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.HasMegaBall}"
                                           AccentColor="#3B82F6"
                                           PlainTextColor="#C8DFF2"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Recurrence results (hidden – replaced by BackTestPage) -->
            <CollectionView x:Name="lstRecurrence"
                            IsVisible="False"
                            ItemsSource="{Binding RecurrenceResults}"
                            SelectionMode="Single"
                            SelectionChanged="Recurrence_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ModelDaily">
                        <Grid Padding="16,12" BackgroundColor="#0D1B2A">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D1B2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D2B1A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Display}" FontFamily="Monospace"
                                   FontSize="13" TextColor="#4ADE80"
                                   LineBreakMode="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Combinations list -->
            <CollectionView x:Name="lstCombos"
                            IsVisible="{Binding ShowCombos}"
                            ItemsSource="{Binding Combinations}"
                            SelectionMode="Single"
                            SelectionChanged="Combos_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,5" BackgroundColor="#0D1B2A">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D1B2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#0D1B2A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border BackgroundColor="#100B28" Stroke="#3D2080"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                                    <BoxView Grid.Column="0" BackgroundColor="#F59E0B"
                                             WidthRequest="4" CornerRadius="4,0,4,0"/>
                                    <local:BubbleNumberRow Grid.Column="1"
                                           Text="{Binding .}"
                                           ShowBubbles="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.ShowBubbles}"
                                           HasMegaBall="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.HasMegaBall}"
                                           AccentColor="#F59E0B"
                                           PlainTextColor="#FBBF24"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 8 — Status bar
             ══════════════════════════════════════════════ -->
        <Label Grid.Row="8" x:Name="lblStatus"
               Text="{Binding StatusMessage}"
               BackgroundColor="#080F1A" TextColor="#3A6080"
               FontSize="11" Padding="14,5"
               LineBreakMode="TailTruncation">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="StatusBar_Tapped"/>
            </Label.GestureRecognizers>
        </Label>

        <!-- ══════════════════════════════════════════════
             Row 9 — Bottom nav bar
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="9" ColumnDefinitions="*,*,*,*,*,*,*"
              HeightRequest="60" BackgroundColor="#080F1A">
            <BoxView Grid.Column="0" Grid.ColumnSpan="7"
                     HeightRequest="1" BackgroundColor="#1E3A5F"
                     VerticalOptions="Start"/>

            <Border Grid.Column="0" BackgroundColor="#14532D" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnResults_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="💲" FontSize="22" HorizontalOptions="Center" TextColor="#4ADE80"/>
                    <Label x:Name="lblResultsNav" Text="Results" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ADE80"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" BackgroundColor="#431407" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnJackpot_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="💲" FontSize="22" HorizontalOptions="Center" TextColor="#FB923C"/>
                    <Label Text="Jackpot" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#FB923C"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" BackgroundColor="#0F2542" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnOptions_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="⚙️" FontSize="22" HorizontalOptions="Center" TextColor="#60A5FA"/>
                    <Label Text="Options" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#60A5FA"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="3" BackgroundColor="#0F2542" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnAdvance_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="🔔" FontSize="22" HorizontalOptions="Center" TextColor="#A78BFA"/>
                    <Label Text="Advance" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#A78BFA"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="4" BackgroundColor="#1A3A1A" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnSummary_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="💳" FontSize="22" HorizontalOptions="Center" TextColor="#4ADE80"/>
                    <Label Text="Spend" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ADE80"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="5" BackgroundColor="#1E3A8A" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnSave_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="💾" FontSize="22" HorizontalOptions="Center" TextColor="#93C5FD"/>
                    <Label Text="Save" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#93C5FD"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="6" BackgroundColor="#1C2B40" Margin="3,2,3,1" Padding="0,0,0,3"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnPrint_Clicked"/></Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                    <Label Text="🖨" FontSize="22" HorizontalOptions="Center" TextColor="#CBD5E1"/>
                    <Label Text="Print" FontSize="8" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#CBD5E1"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════
             Row 10 — Insert combos (combos tab only)
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="10" x:Name="insertCombosRow" IsVisible="False"
              ColumnDefinitions="*,Auto" Margin="10,4,10,8">
            <Button Grid.Column="0" x:Name="btnInsertToWinner"
                    Text="Insert Combos → F5 Winner"
                    FontSize="13" FontAttributes="Bold"
                    BackgroundColor="#C2410C" TextColor="White"
                    HeightRequest="44" CornerRadius="10"
                    Clicked="BtnInsertToWinner_Clicked"/>
            <Button Grid.Column="1" x:Name="btnClearCombos"
                    Text="✕"
                    FontSize="16" FontAttributes="Bold"
                    BackgroundColor="#546E7A" TextColor="White"
                    HeightRequest="44" WidthRequest="44" CornerRadius="10"
                    Margin="6,0,0,0"
                    Clicked="BtnClearCombos_Clicked"/>
        </Grid>

        <!-- Nav loading overlay — shown instantly when navigating to slow pages (Results etc.) -->
        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="navLoadingOverlay"
              BackgroundColor="#000000" Opacity="0.001" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                <ActivityIndicator x:Name="navLoadingSpinner" IsRunning="False"
                                   Color="#F59E0B" WidthRequest="52" HeightRequest="52"/>
                <Label x:Name="navLoadingLabel" Text="Loading Results..."
                       TextColor="White" FontSize="15" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Loading overlay — matches splash screen, shows progress.
             IsVisible is managed in code-behind (not bound) so hiding it can fade
             instead of snapping instantly — see the vm.PropertyChanged hookup in
             MainPage.xaml.cs. -->
        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="loadingOverlay"
              BackgroundColor="#0F1923" IsVisible="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="18" Padding="48,0">
                <Image Source="ball_logo.svg" WidthRequest="110" HeightRequest="110"
                       HorizontalOptions="Center"/>
                <Label Text="CA Lottery Tracker" TextColor="White"
                       FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                <ProgressBar x:Name="loadingBar"
                             Progress="{Binding LoadingProgress}"
                             ProgressColor="#F59E0B"
                             WidthRequest="280" ScaleY="4"
                             HorizontalOptions="Center"
                             Margin="0,10,0,10"/>
                <Label Text="{Binding LoadingMessage}" TextColor="#90CAF9"
                       FontSize="13" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Delete mode bar -->
        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="deleteModeBar"
              IsVisible="False" VerticalOptions="End" InputTransparent="False">
            <Grid BackgroundColor="#7F1D1D" Padding="12,10"
                  ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" x:Name="lblDeleteCount"
                       Text="Tap items to select"
                       TextColor="White" FontSize="14" FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1" x:Name="btnDeleteSelected" Text="Delete"
                        BackgroundColor="#450A0A" TextColor="White" FontSize="12"
                        HeightRequest="38" WidthRequest="82" CornerRadius="8"
                        Clicked="DeleteSelectedItems_Clicked"/>
                <Button Grid.Column="2" Text="Done"
                        BackgroundColor="#1E293B" TextColor="White" FontSize="12"
                        HeightRequest="38" WidthRequest="64" CornerRadius="8"
                        Clicked="ExitDeleteMode_Clicked"/>
            </Grid>
        </Grid>

        <!-- ── Smart QP Strategy overlay ─────────────────────────────────── -->
        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="qpOverlay"
              BackgroundColor="#CC000000" IsVisible="False">
            <Border BackgroundColor="#0E2039" Stroke="#6D28D9" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20" Padding="20"
                    VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340">
                <VerticalStackLayout Spacing="14">

                    <Label x:Name="qpTitle" Text="🎲 Smart Quick Pick"
                           FontSize="15" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="White"/>

                    <Label Text="How should I search the draw history?"
                           FontSize="12" HorizontalOptions="Center" TextColor="#94B8D8"
                           HorizontalTextAlignment="Center"/>

                    <!-- Strategy grid -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" x:Name="qpBtnHot"
                                Text="🔥 Hot Numbers" FontSize="11"
                                BackgroundColor="#6D28D9" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpStrategy_Hot"/>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="qpBtnCold"
                                Text="❄️ Cold / Overdue" FontSize="11"
                                BackgroundColor="#1E3A5F" TextColor="#94B8D8"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpStrategy_Cold"/>
                        <Button Grid.Row="1" Grid.Column="0" x:Name="qpBtnFreq"
                                Text="📊 Most Frequent" FontSize="11"
                                BackgroundColor="#1E3A5F" TextColor="#94B8D8"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpStrategy_Freq"/>
                        <Button Grid.Row="1" Grid.Column="1" x:Name="qpBtnRare"
                                Text="💎 Least Drawn" FontSize="11"
                                BackgroundColor="#1E3A5F" TextColor="#94B8D8"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpStrategy_Rare"/>
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                x:Name="qpBtnGap"
                                Text="⏳ Longest Gap (Due)" FontSize="11"
                                BackgroundColor="#1E3A5F" TextColor="#94B8D8"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpStrategy_Gap"/>
                    </Grid>

                    <!-- How many numbers to generate -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="How many numbers to pick:"
                               FontSize="11" TextColor="#94B8D8" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#0A1628" Stroke="#1E3A5F"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0">
                            <Entry x:Name="qpFrom" Keyboard="Numeric"
                                   FontSize="14" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="Black" BackgroundColor="#D6E8FF"
                                   WidthRequest="60" HeightRequest="36"/>
                        </Border>
                    </Grid>

                    <!-- Last-N entry (Hot strategy only) -->
                    <Grid x:Name="qpLastNRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Recent draws to analyze:"
                               FontSize="11" TextColor="#94B8D8" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="qpLastN" Text="100" Keyboard="Numeric"
                               FontSize="13" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="Black" BackgroundColor="#D6E8FF"
                               WidthRequest="60" HeightRequest="36"/>
                    </Grid>

                    <!-- Progress area (hidden until Generate is tapped) -->
                    <VerticalStackLayout x:Name="qpProgressArea" IsVisible="False" Spacing="6">
                        <ActivityIndicator x:Name="qpSpinner" IsRunning="False"
                                           Color="#F59E0B" WidthRequest="36" HeightRequest="36"
                                           HorizontalOptions="Center"/>
                        <Label x:Name="qpProgressMsg" Text="" FontSize="11"
                               TextColor="#F59E0B" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Cancel / Generate -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" x:Name="qpCancelBtn" Text="Cancel"
                                BackgroundColor="#1E293B" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpCancel_Clicked"/>
                        <Button Grid.Column="1" x:Name="qpGenerateBtn" Text="Generate"
                                BackgroundColor="#6D28D9" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="QpGenerate_Clicked"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Reorder overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="reorderOverlay"
              BackgroundColor="#CC000000" IsVisible="False">
            <Border BackgroundColor="#0E2039" Stroke="#1E3A5F" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20" Padding="24"
                    VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Reorder Numbers" FontSize="17" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="Tap a number, then tap another to swap"
                           FontSize="12" HorizontalOptions="Center" TextColor="#4A7FB5"/>
                    <HorizontalStackLayout x:Name="reorderNumbers"
                                          HorizontalOptions="Center" Spacing="8"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Cancel"
                                BackgroundColor="#1E293B" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="ReorderCancel_Clicked"/>
                        <Button Grid.Column="1" Text="Apply"
                                BackgroundColor="#2563EB" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="ReorderApply_Clicked"/>
                    </Grid>
                    <Button x:Name="btnDeleteFromOverlay" Text="🗑 Delete This Item"
                            BackgroundColor="#7F1D1D" TextColor="White"
                            CornerRadius="10" HeightRequest="44"
                            Clicked="DeleteFromOverlay_Clicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="11" x:Name="searchNumOverlay"
              BackgroundColor="#CC000000" IsVisible="False">
            <Border BackgroundColor="#0E2039" Stroke="#1E3A5F" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20" Padding="20"
                    VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="searchNumTitle" Text="Search Sets" FontSize="17" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="Leave boxes blank to skip a number"
                           FontSize="11" HorizontalOptions="Center" TextColor="#4A7FB5"/>
                    <FlexLayout x:Name="searchNumBoxes" Wrap="Wrap" JustifyContent="Center"
                                HorizontalOptions="Center" Margin="0,4"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Cancel"
                                BackgroundColor="#1E293B" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="SearchNumCancel_Clicked"/>
                        <Button Grid.Column="1" Text="Search"
                                BackgroundColor="#0F766E" TextColor="White"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="SearchNumSearch_Clicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Row 11 — safe-area spacer: extends the nav bar's background color under the
             system nav bar so button labels in Row 9 aren't clipped by it. Height is set
             at runtime from the device's real inset (see MainPage.xaml.cs constructor). -->
        <BoxView Grid.Row="11" x:Name="bottomSafeAreaSpacer"
                 HeightRequest="0" BackgroundColor="#080F1A"/>

    </Grid>
</ContentPage>
