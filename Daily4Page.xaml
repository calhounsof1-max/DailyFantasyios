<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFantasyMAUI.Daily4Page"
             xmlns:local="clr-namespace:DailyFantasyMAUI"
             Title="Daily 4 Checker"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,1">
        <Grid.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnPagePan"/>
        </Grid.GestureRecognizers>

        <!-- Row 0: Nav header -->
        <Grid Grid.Row="0" BackgroundColor="#1E2733" Padding="8,4"
              ColumnDefinitions="Auto,*,Auto,Auto">
            <GraphicsView Grid.ColumnSpan="4"
                          Opacity="0.70" HeightRequest="38" WidthRequest="38"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          InputTransparent="True">
                <GraphicsView.Drawable><local:BallWatermark/></GraphicsView.Drawable>
            </GraphicsView>
            <Button Grid.Column="0" Text="⌂" FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#2D3D50" TextColor="White" Padding="10,0"
                    HeightRequest="26" MinimumHeightRequest="0" CornerRadius="13" Clicked="BtnGoHome_Clicked" Margin="0,0,6,0"/>
            <Label Grid.Column="1" Text="Daily 4" TextColor="White" FontSize="11"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Game ▼" FontSize="11" FontAttributes="Bold"
                    BackgroundColor="#2D3D50" TextColor="White" Padding="10,0"
                    HeightRequest="26" MinimumHeightRequest="0" CornerRadius="13" Clicked="BtnGameMenu_Clicked" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Text="Intelligence ▼" FontSize="10" FontAttributes="Bold"
                    BackgroundColor="#FFB300" TextColor="#1A1A2E" Padding="10,0"
                    HeightRequest="26" MinimumHeightRequest="0" CornerRadius="13" Clicked="BtnNumIntel_Clicked"/>
        </Grid>

        <!-- Row 6: Status bar -->
        <Label Grid.Row="6" x:Name="lblStatus" Text="Ready"
               BackgroundColor="#1E2733" TextColor="#8B9DC3"
               FontSize="12" Padding="14,5" LineBreakMode="TailTruncation">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="StatusBar_Tapped"/>
            </Label.GestureRecognizers>
        </Label>

        <!-- Hidden WebView -->
        <WebView x:Name="fetchView" Grid.Row="7" HeightRequest="1" WidthRequest="1"
                 Opacity="0" InputTransparent="True"/>

        <!-- Row 1: Draw banner card -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0"
                StrokeShape="RoundRectangle 0" Margin="0">
            <VerticalStackLayout Padding="14,10" Spacing="6">
                <Image Source="logo_daily4.png" HeightRequest="90"
                       HorizontalOptions="Center" Aspect="AspectFit" Margin="0,4,0,2"/>
                <Grid ColumnDefinitions="*,Auto">
                    <DatePicker Grid.Column="0" x:Name="drawDatePicker" FontSize="13" TextColor="#374151"
                                Format="ddd MMM d, yyyy" HeightRequest="44"
                                DateSelected="DrawDatePicker_DateSelected"/>
                    <Label Grid.Column="1" x:Name="lblTicketCount"
                           FontSize="12" FontAttributes="Bold" TextColor="#00695C"
                           VerticalOptions="Center" HorizontalOptions="End" Margin="6,0,4,0"/>
                </Grid>
                <Label x:Name="lblDrawDate" Text="Fetching Daily 4 draw..."
                       FontSize="12" TextColor="#6B7A90" HorizontalOptions="Center"/>

                <!-- Single draw row -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border x:Name="W1" BackgroundColor="#00695C" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                        <Label x:Name="lblW1" Text="?" FontSize="24" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="W2" BackgroundColor="#00695C" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                        <Label x:Name="lblW2" Text="?" FontSize="24" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="W3" BackgroundColor="#00695C" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                        <Label x:Name="lblW3" Text="?" FontSize="24" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border x:Name="W4" BackgroundColor="#00695C" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                        <Label x:Name="lblW4" Text="?" FontSize="24" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <ActivityIndicator x:Name="spinner" IsRunning="False" IsVisible="False"
                                       Color="#00695C" WidthRequest="28" HeightRequest="28"
                                       VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Row 2: From highlight control + All-rows bet type -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="12,5"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <BoxView Grid.Column="0" BackgroundColor="#00695C" WidthRequest="4"
                     VerticalOptions="Fill" Margin="0,4,10,4"/>
            <Label Grid.Column="1" Text="From Date:" FontSize="13" TextColor="#374151"
                   VerticalOptions="Center" FontAttributes="Bold"/>
            <Entry Grid.Column="2" x:Name="fromEntry" Keyboard="Numeric" WidthRequest="56"
                   HeightRequest="34" FontSize="15" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" TextColor="Black" BackgroundColor="#F8F9FA"
                   TextChanged="FromEntry_TextChanged"/>
            <Label Grid.Column="3" Text=" rows" FontSize="12"
                   TextColor="#9CA3AF" VerticalOptions="Center"/>
            <Label Grid.Column="4" Text="" />
            <Grid Grid.Column="5" ColumnDefinitions="Auto,Auto" ColumnSpacing="4"
                  VerticalOptions="Center">
                <Label Grid.Column="0" Text="All:" FontSize="11" TextColor="#546E7A"
                       VerticalOptions="Center"/>
                <Picker Grid.Column="1" x:Name="allBetPicker" FontSize="11"
                        WidthRequest="78" HeightRequest="34" BackgroundColor="#F8F9FA"
                        SelectedIndexChanged="AllBetPicker_Changed"/>
            </Grid>
        </Grid>

        <!-- Row 3: Saved Numbers picker -->
        <Grid Grid.Row="3" BackgroundColor="White" Padding="12,6"
              ColumnDefinitions="Auto,*">
            <BoxView Grid.Column="0" BackgroundColor="#00695C" WidthRequest="4"
                     VerticalOptions="Fill" Margin="0,4,10,4"/>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Saved Numbers" FontSize="13" FontAttributes="Bold"
                           TextColor="#374151" VerticalOptions="Center" Margin="0,0,8,0"/>
                    <Picker Grid.Column="1" x:Name="slotPicker" FontSize="13"
                            BackgroundColor="#F8F9FA" HeightRequest="36"
                            SelectedIndexChanged="SlotPicker_Changed"
                            Focused="SlotPicker_Focused"/>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center"
                                         VerticalOptions="Center" Spacing="0" Margin="6,0,2,0">
                        <Label Text="Excl" FontSize="9" TextColor="#666" HorizontalOptions="Center"/>
                        <CheckBox x:Name="chkExcl" Color="#C62828" HorizontalOptions="Center"
                                  CheckedChanged="ChkExcl_CheckedChanged" Margin="0,-4,0,0"/>
                    </VerticalStackLayout>
                </Grid>
                <Grid x:Name="advAllPanel" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,78,Auto,78,Auto" ColumnSpacing="4" RowSpacing="3" Padding="0,0,0,2">
                    <!-- Row 0: Draw# -->
                    <Label Grid.Row="0" Grid.Column="0" Text="Draw#" FontSize="11" TextColor="#0277BD" VerticalOptions="Center"/>
                    <Entry Grid.Row="0" Grid.Column="1" x:Name="entAdvAllStart" Placeholder="Start #" Keyboard="Numeric"
                           FontSize="12" HeightRequest="32" BackgroundColor="#F0F4F8"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="–" FontSize="11" TextColor="#9CA3AF" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Entry Grid.Row="0" Grid.Column="3" x:Name="entAdvAllEnd" Placeholder="End (opt)" Keyboard="Numeric"
                           FontSize="12" HeightRequest="32" BackgroundColor="#F0F4F8"/>
                    <!-- Row 1: Dates -->
                    <Label Grid.Row="1" Grid.Column="0" Text="From:" FontSize="11" TextColor="#2E7D32" FontAttributes="Bold" VerticalOptions="Center"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="advAllFromPicker"
                                Format="M/d/yy" FontSize="11" HeightRequest="32"
                                BackgroundColor="#F0F4F8" TextColor="#374151"
                                MinimumDate="2020/01/01" MaximumDate="2035/12/31"/>
                    <Label Grid.Row="1" Grid.Column="2" Text="To:" FontSize="11" TextColor="#2E7D32" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <DatePicker Grid.Row="1" Grid.Column="3" x:Name="advAllToPicker"
                                Format="M/d/yy" FontSize="11" HeightRequest="32"
                                BackgroundColor="#F0F4F8" TextColor="#374151"
                                MinimumDate="2020/01/01" MaximumDate="2035/12/31"/>
                    <!-- Set button spans both rows -->
                    <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Text="Set" FontSize="10" FontAttributes="Bold"
                            BackgroundColor="#0277BD" TextColor="White"
                            CornerRadius="6" Padding="8,0" Margin="4,0,0,0"
                            VerticalOptions="Center"
                            Clicked="BtnAdvAllCombinedSet_Clicked"/>
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Row 4: 10 number rows -->
        <ScrollView Grid.Row="4" BackgroundColor="#F0F4F8">
            <VerticalStackLayout x:Name="rowsContainer" Padding="10,8" Spacing="5"/>
        </ScrollView>

        <!-- Row 5: Bottom buttons -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,*,Auto,Auto" ColumnSpacing="6"
              Padding="10,8" BackgroundColor="#1E2733">
            <Button Grid.Column="0" Text="Check" FontSize="10" FontAttributes="Bold"
                    BackgroundColor="#F9A825" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="4,0" Clicked="BtnCheck_Clicked"/>
            <Button Grid.Column="1" Text="Clear" FontSize="10"
                    BackgroundColor="#FF7043" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="4,0" Clicked="BtnClearAll_Clicked"/>
            <Button Grid.Column="2" Text="Refresh" FontSize="10"
                    BackgroundColor="#00695C" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="4,0" Clicked="BtnRefresh_Clicked"/>
            <Button Grid.Column="3" Text="Save" FontSize="10"
                    BackgroundColor="#2E7D32" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="4,0" Clicked="BtnSave_Clicked"/>
            <Button Grid.Column="4" Text="Clr Sets" FontSize="10"
                    BackgroundColor="#B71C1C" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="4,0" Clicked="BtnClearSets_Clicked"/>
            <Button x:Name="btnOverride" Grid.Column="5" Text="OVR" FontSize="10"
                    BackgroundColor="#546E7A" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="10,0" Clicked="BtnOverride_Clicked"/>
            <Button Grid.Column="6" x:Name="btnVoice" Text="🎤" FontSize="18"
                    BackgroundColor="#0277BD" TextColor="White" HeightRequest="42"
                    CornerRadius="21" Padding="10,0" Clicked="BtnVoice_Clicked"/>
        </Grid>
        <!-- Full-page loading overlay -->
        <Grid x:Name="loadingOverlay" Grid.RowSpan="8" BackgroundColor="#CC1E2733"
              IsVisible="True" InputTransparent="True">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="56" HeightRequest="56"/>
                <Label Text="Loading..." TextColor="White" FontSize="16" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
