<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyFantasyMAUI"
             x:Class="DailyFantasyMAUI.RundownPage"
             Title="Rundown Calculator"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" BackgroundColor="#1E2733" Padding="14,10"
              ColumnDefinitions="Auto,*,Auto">
            <GraphicsView Grid.ColumnSpan="3"
                          Opacity="0.70" HeightRequest="54" WidthRequest="54"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          InputTransparent="True">
                <GraphicsView.Drawable><local:BallWatermark/></GraphicsView.Drawable>
            </GraphicsView>
            <Button Grid.Column="0" Text="⌂" FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#2D3D50" TextColor="White" Padding="10,0"
                    HeightRequest="34" CornerRadius="17"
                    Clicked="BtnGoHome_Clicked" Margin="0,0,6,0"/>
            <Label Grid.Column="1" Text="Rundown Calculator" TextColor="White"
                   FontSize="14" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Picker Grid.Column="2" x:Name="gamePicker" FontSize="11"
                    TextColor="White" BackgroundColor="#2D3D50"
                    WidthRequest="90" HeightRequest="34"
                    SelectedIndexChanged="GamePicker_Changed"/>
        </Grid>

        <!-- Row 1: Game logo banner -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="8,6">
            <Image x:Name="imgGameLogo" HeightRequest="80"
                   Aspect="AspectFit" HorizontalOptions="Center"/>
        </Border>

        <!-- ── Scrollable content ── -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="12,10" Spacing="10">

                <!-- Seed card -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="14,12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Starting Number"
                               FontSize="13" FontAttributes="Bold" TextColor="#1E2733"/>
                        <Label Text="Enter the last winning draw or any key number:"
                               FontSize="12" TextColor="#6B7280"/>
                        <HorizontalStackLayout x:Name="seedRow"
                                               Spacing="10" HorizontalOptions="Center"/>
                        <Label x:Name="lblSeedSum" Text=""
                               FontSize="11" TextColor="#9CA3AF"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Step card -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="14,12">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Rundown Step" FontSize="13"
                               FontAttributes="Bold" TextColor="#1E2733"/>

                        <!-- Preset pills -->
                        <Label Text="Quick presets:" FontSize="11" TextColor="#6B7280"/>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <FlexLayout x:Name="presetRow"
                                        Direction="Row" Wrap="NoWrap"
                                        AlignItems="Center"/>
                        </ScrollView>

                        <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                        <!-- Custom step + direction -->
                        <Label Text="Custom step:" FontSize="11" TextColor="#6B7280"/>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                            <!-- Direction toggle -->
                            <Border x:Name="directionBorder"
                                    BackgroundColor="#1565C0" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    WidthRequest="44" HeightRequest="44">
                                <Label x:Name="directionLabel" Text="+"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleDirection_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ToggleDirection_Tapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <!-- Step digit entries -->
                            <HorizontalStackLayout x:Name="stepRow" Spacing="8"/>
                        </HorizontalStackLayout>

                        <Label x:Name="lblStepHint"
                               Text="Add 1 to each digit position per row"
                               FontSize="11" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Calculate button -->
                <Button x:Name="btnCalc" Text="Calculate Rundown"
                        BackgroundColor="#1565C0" TextColor="White"
                        FontSize="15" FontAttributes="Bold"
                        CornerRadius="10" HeightRequest="48"
                        Clicked="BtnCalculate_Clicked"/>

                <!-- Results card -->
                <Border x:Name="resultsCard" IsVisible="False"
                        BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="14,12">
                    <VerticalStackLayout Spacing="6">

                        <!-- Results header -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <Label Grid.Column="0" x:Name="lblResultTitle"
                                   Text="Rundown Results"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#1E2733" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Copy All" FontSize="12"
                                    BackgroundColor="#2E7D32" TextColor="White"
                                    HeightRequest="34" CornerRadius="8" Padding="12,0"
                                    Clicked="BtnCopyAll_Clicked"/>
                        </Grid>

                        <!-- Column headers -->
                        <Grid x:Name="colHeaderRow" ColumnDefinitions="48,*,Auto"
                              Margin="0,0,0,4">
                            <Label Grid.Column="0" Text="Row"
                                   FontSize="11" TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1" Text="Number"
                                   FontSize="11" TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2" Text="Sum"
                                   FontSize="11" TextColor="#9CA3AF"
                                   HorizontalTextAlignment="End"
                                   WidthRequest="36"/>
                        </Grid>

                        <!-- Result rows -->
                        <VerticalStackLayout x:Name="resultsContainer" Spacing="3"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Mirror reference card -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="14,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mirror Reference  (0↔5  1↔6  2↔7  3↔8  4↔9)"
                               FontSize="12" FontAttributes="Bold" TextColor="#1E2733"/>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*">
                            <Border Grid.Column="0" BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="0↔5" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="1↔6" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="2↔7" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="3↔8" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="4" BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="4↔9" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="5" BackgroundColor="#0D47A1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="5↔0" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="6" BackgroundColor="#0D47A1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="6↔1" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="7" BackgroundColor="#0D47A1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="7↔2" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="8" BackgroundColor="#0D47A1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="8↔3" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="9" BackgroundColor="#0D47A1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="0,4" Margin="2">
                                <Label Text="9↔4" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Status bar ── -->
        <Label Grid.Row="3" x:Name="lblStatus"
               Text="Enter your starting number, pick a step, then tap Calculate."
               BackgroundColor="#1E2733" TextColor="#8B9DC3"
               FontSize="12" Padding="14,6" LineBreakMode="TailTruncation"/>

    </Grid>
</ContentPage>
